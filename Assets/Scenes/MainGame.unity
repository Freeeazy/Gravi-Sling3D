      objectReference: {fileID: 0}
    - target: {fileID: 2636418418823871894, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_text
      value: "Some packages do more than sit in your cargo hold.\n\nCargo can affect
        the way your ship handles, change your <color=#59E6FF>speed</color> or <color=#FF8C40>mass</color>,
        <color=#FF5555>attract attention</color>, or create other complications during
        a delivery.\n\nCheck the job information before launching so you know what
        you\u2019re carrying.\n\n\n<size=85%><color=#20843E>Sometimes the <color=#B66CFF>weirdest</color>
        package is worth taking just to see what happens.</size></color>"
      objectReference: {fileID: 0}
    - target: {fileID: 2636418418823871894, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
