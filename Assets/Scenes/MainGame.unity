    - target: {fileID: 3111145781504989670, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_text
      value: "Take jobs. Fly fast. Deliver strange things.\n\n\nExplore the system
        at your own pace and choose the jobs that sound interesting to you.\n\n\nYou
        can reopen this guide at any time from:\n\n<b>ESC \u2192 HELP</b>"
      objectReference: {fileID: 0}
