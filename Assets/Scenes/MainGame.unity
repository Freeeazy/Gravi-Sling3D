    - target: {fileID: 7056684399976027325, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_text
      value: "<b><color=#00FF4E><size=120%>SAFE</b></size>\nStraightforward courier
        work. Lower risk and generally predictable cargo.</color>\n\n<b><color=#FF2020><size=120%>RISKY</b></size>\nQuestionable
        clients, suspicious cargo, and jobs more likely to attract unwanted attention.</color>\n\n<b><color=#B66CFF><size=120%>WEIRD</b></size>\nUnusual
        requests, strange cargo, and deliveries where you may not know exactly what
        you\u2019re getting yourself into.</color>\n\n\n<size=85%>Pick whatever sounds
        interesting. There\u2019s no single \u201Ccorrect\u201D way to play.</size>"
      objectReference: {fileID: 0}
    - target: {fileID: 7056684399976027325, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_fontColor.b
      value: 0.24313726
      objectReference: {fileID: 0}
