    m_Modifications:
    - target: {fileID: 25136912946182206, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_text
      value: "Orbit a <u>station</u> to access its <b>Delivery Menu [F]</b>.\n\nFrom
        there, choose the type of job you\u2019re looking for and accept a package.
        Your destination will be marked once the delivery begins.\n\nDeliver the
        package successfully to earn <b>credits</b> and improve your standing as
        a courier.\n\n\n<size=85%><color=#20843E>Good and Perfect deliveries have
        a chance to reward <b>bonus</b> upgrade modules</size></color>"
      objectReference: {fileID: 0}
    - target: {fileID: 25136912946182206, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_fontColor.b
