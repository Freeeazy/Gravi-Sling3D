    - target: {fileID: 7923751138560750793, guid: 0fe78255669ecdf458fdf468d9d05a4f, type: 3}
      propertyPath: m_text
      value: "You\u2019re an independent <u>courier</u> working your way across the
        system.\n\nTake delivery jobs from strangers, sling yourself between stations,
        earn credits, and decide how much trouble you\u2019re willing to get into
        along the way.\n\n\n<size=85%><color=#20843E>Flight School covers the basics
        of piloting your ship. This guide covers everything else.</size></color>"
      objectReference: {fileID: 0}
