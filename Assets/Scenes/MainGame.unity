MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1977218264}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 594afae5b60d2174b9eeda7f757622c0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  useTutorialSeenPlayerPref: 1
  resetTutorialSeenOnStart: 0
  useStartingWarningStage: 1
  startingWarningObject: {fileID: 311769837}
  startingWarningTitle: 
  startingWarningMessage: STANDBY FOR AUTOMATED MESSAGE FROM UNCLE DANTE
  startingWarningDuration: 3
  startingWarningOnDuration: 0.75
  startingWarningOffDuration: 0.5
  hideWarningObjectAfter: 0
  tutorialText: {fileID: 1624636271}
  tutorialPanel: {fileID: 1977218264}
  npcIconImage: {fileID: 724104433}
  npcIconRect: {fileID: 149255031}
  npcTalkRotationAmount: 4
  npcTalkRotationSpeed: 28
  charactersPerSecond: 35
  useTypewriterEffect: 1
  stages:
  - title: 
    message: 'Welcome to the Family!

'
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1.5
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable:
    - {fileID: 724104431}
    objectsToDisable:
    - {fileID: 1871277327}
    - {fileID: 122382622}
  - title: 
    message: "You\u2019ve passed your piloting test, kid. "
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: "That means you are now a proud licensed courier for Uncle Dante\u2019s
      Flaming Hot Pizzeria."
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: Your ship has been equipped with every luxury a loving uncle could legally
      deny owning.
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'A pizza warmer, @0.5delivery timers, @0.5gravity sling compatibility,
      @0.5and a @0.1mostly indestructible hull.

'
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: Mostly...
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: The hull can take a beating. @0.5Your packages cannot.
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: Any cargo damaged during collisions will be deducted from your paycheck,
      @0.5your reputation, @0.5and my already limited patience.
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'The Dante Guarantee is simple:'
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'Any package. @1Any station. @1Ten minutes or less.

'
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: Thanks to our revolutionary gravity sling drive network
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1.5
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'We can deliver almost anything across the galaxy before the customer
      has time to regret ordering it. '
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'Fail that promise@0.25, and I may be forced to personally compensate
      the customer with free pizza for life. '
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: Nobody wants that.
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1.5
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'Especially accounting.

'
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1.5
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: No pressure, kid.
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1.5
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: 'Now quit reading the fine print and fly over to the marked station.
      @1Your first delivery is waiting.

'
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 2
    scriptsToEnable: []
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  - title: 
    message: "Welcome to the Family. @1Don\u2019t embarrass us."
    ringsRequired: 0
    autoAdvance: 1
    autoAdvanceDelay: 1.5
    scriptsToEnable:
    - {fileID: 1616803245}
    scriptsToDisable: []
    objectsToEnable: []
    objectsToDisable: []
  allowSkipTutorial: 1
  skipKey: 102
  skipHoldDuration: 2
  simpleMove: {fileID: 1616803245}
